# SonicWave — production environment.
# In production ALL of the following (except GEMINI/FIREBASE_PROJECT_ID) are
# REQUIRED; the app refuses to boot without them (fail-closed, see src/config).

NODE_ENV=production
PORT=8080                                   # injected by Cloud Run; do not hardcode

# Data + queue (managed services, not local files/mocks)
DATABASE_URL=postgres://user:pass@host:5432/sonicwave
REDIS_URL=rediss://user:pass@host:6379

# Stripe (real keys; webhook secret is required so entitlements persist)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Object storage for rendered exports (GCS/S3 bucket)
STORAGE_BUCKET=sonicwave-exports

# Exact browser origins allowed (comma-separated, NO wildcard)
CORS_ORIGINS=https://app.v12sonicwave.com,https://studio.v12sonicwave.com

# Firebase project (Admin SDK uses ADC / service account via GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_PROJECT_ID=gen-lang-client-0237733980

# Optional
GEMINI_API_KEY=
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
SENTRY_DSN=
